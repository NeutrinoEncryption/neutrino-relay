[Unit]
Description=Neutrino blind pairing relay
After=network-online.target
Wants=network-online.target

[Service]
User=neutrino
Environment=NEUTRINO_RELAY_BIND=127.0.0.1:8787
ExecStart=/usr/local/bin/neutrino-relay
Restart=always
RestartSec=2
LimitNOFILE=65536
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
